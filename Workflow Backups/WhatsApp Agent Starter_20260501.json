    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.memoryBySender) {\n  staticData.memoryBySender = {};\n}\n\nconst inputItems = $input.all();\nconst out = [];\nfor (const item of inputItems) {\n  const json = item.json;\n  const sender = json.sender_phone;\n  const memoryWindow = Number(json.cfg_memory_window_turns || 20);\n  const incomingText = json.incoming_text || '[empty]';\n\n  const history = staticData.memoryBySender[sender] || [];\n  history.push({ role: 'user', text: incomingText, ts: new Date().toISOString() });\n\n  const boundedHistory = history.slice(-memoryWindow);\n\n  // Keep the current behavior stable while we integrate model calls iteratively.\n  const assistantText = `You said: ${incomingText}`;\n\n  boundedHistory.push({ role: 'assistant', text: assistantText, ts: new Date().toISOString() });\n  staticData.memoryBySender[sender] = boundedHistory.slice(-memoryWindow);\n\n  const rate = Number(json.cfg_estimated_cost_per_1k_chars_usd || 0);\n  const totalChars = incomingText.length + assistantText.length;\n  const estimatedCostUsd = Number(((totalChars / 1000) * rate).toFixed(6));\n\n  out.push({\n    json: {\n      ...json,\n      assistant_text: assistantText,\n      estimated_cost_usd: estimatedCostUsd\n    }\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        416
      ],
      "id": "bf3ec88c-18da-4d14-812e-8e4985a7df98",
      "name": "Build Reply And Memory"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.monthlyCost) {\n  staticData.monthlyCost = {};\n}\n\nconst now = new Date();\nconst monthKey = `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`;\nconst inputItems = $input.all();\nconst out = [];\n\nfor (const item of inputItems) {\n  const json = item.json;\n  const record = staticData.monthlyCost[monthKey] || { total_usd: 0, alert_sent: false, updated_at: null };\n  const delta = Number(json.estimated_cost_usd || 0);\n\n  record.total_usd = Number((record.total_usd + delta).toFixed(6));\n  record.updated_at = now.toISOString();\n  staticData.monthlyCost[monthKey] = record;\n\n  const threshold = Number(json.cfg_monthly_cost_limit_usd || 25);\n  const alertNeeded = Boolean(json.cfg_cost_alert_enabled) && !record.alert_sent && record.total_usd >= threshold;\n\n  out.push({\n    json: {\n      ...json,\n      cost_month_key: monthKey,\n      cost_total_usd: record.total_usd,\n      cost_alert_needed: alertNeeded\n    }\n  });\n}\n\nreturn out;"
      },
