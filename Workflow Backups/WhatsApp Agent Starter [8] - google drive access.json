        "jsonBody": "={{ JSON.stringify({\n  contents: [\n    {\n      parts: [\n        {\n          text: 'Transcribe this WhatsApp voice message exactly. Return only the transcript text, with no extra explanation.'\n        },\n        {\n          inline_data: {\n            mime_type: $json.audio_mime_type || 'audio/ogg',\n            data: $json.audio_base64\n          }\n        }\n      ]\n    }\n  ],\n  generationConfig: {\n    temperature: 0\n  }\n}) }}",
