    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\nconst out = [];\n\nfor (let i = 0; i < inputItems.length; i++) {\n  const item = inputItems[i];\n  const binaryMeta = item.binary?.data;\n\n  if (!binaryMeta) {\n    throw new Error('Missing downloaded audio binary in field: data');\n  }\n\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n\n  out.push({\n    json: {\n      ...item.json,\n      audio_base64: buffer.toString('base64'),\n      audio_mime_type: binaryMeta.mimeType || 'audio/ogg'\n    }\n  });\n}\n\nreturn out;"
      },
