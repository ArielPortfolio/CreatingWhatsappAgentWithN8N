    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "number": [
            {
              "name": "cfg_memory_window_turns",
              "value": 20
            },
            {
              "name": "cfg_monthly_cost_limit_usd",
              "value": 25
            },
            {
              "name": "cfg_estimated_cost_per_1k_chars_usd",
              "value": 0.0005
            }
          ],
          "string": [
            {
              "name": "cfg_owner_whatsapp_e164",
              "value": "+1234567890"
            }
          ],
