      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cost-alert-needed",
              "leftValue": "={{ $json.cost_alert_needed ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        600,
        140
      ],
      "id": "4fd8e68c-f2f1-43f0-a4b7-a8327d215ca6",
      "name": "Cost Alert Needed?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.cfg_owner_whatsapp_e164, type: 'text', text: { body: 'Cost alert: monthly estimated usage is $' + $json.cost_total_usd + ' for ' + $json.cost_month_key + '. Limit: $' + $json.cfg_monthly_cost_limit_usd + '.' } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        820,
        80
      ],
      "id": "cdbf5f3e-c908-468b-a32c-eb52cb44007d",
      "name": "Send Cost Alert"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.monthlyCost) {\n  staticData.monthlyCost = {};\n}\n\nconst inputItems = $input.all();\nfor (const item of inputItems) {\n  const key = item.json.cost_month_key;\n  if (key && staticData.monthlyCost[key]) {\n    staticData.monthlyCost[key].alert_sent = true;\n    staticData.monthlyCost[key].updated_at = new Date().toISOString();\n  }\n}\n\nreturn inputItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        80
      ],
      "id": "1c7788d8-9628-408f-a7fd-4f2b4f87d2a3",
